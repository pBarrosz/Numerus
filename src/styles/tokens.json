{
  "color": {
    "black": "#0A0A0A",
    "offWhite": "#F2F0E9",
    "green": "#149E48",
    "greenDark": "#0E7F39",
    "grid": "#DCD9CF",
    "muted": "#CFCBBF",
    "hover": "#333333"
  },
  "font": {
    "family": "JetBrains Mono",
    "weights": { "body": 400, "medium": 500, "label": 700, "display": 800 },
    "tracking": { "display": "-0.05em", "label": "0.08em" },
    "size": { "label": 12, "body": 14, "lead": 16, "kpi": 34, "h1": 40, "hero": 72 }
  },
  "space": { "unit": 8, "1": 8, "2": 16, "3": 24, "4": 32 },
  "border": { "frame": 8, "card": 6, "button": 4, "row": 3 },
  "radius": 0,
  "shadow": "5px 5px 0 #0A0A0A",
  "rules": [
    "green is fill only — never green text on off-white",
    "no border radius",
    "labels in uppercase with 0.08em tracking",
    "section headers numbered as [NN] TITLE"
  ]
}
